# Dependencies
/vendor
/backend/vendor
/frontend/node_modules
node_modules/

# Builds
/frontend/build
/backend/public/build
/backend/public/hot

# Environment / secrets
.env
/frontend/.env
.env.backup
.env.production
*.key

# Docker secrets — mounted at runtime, never committed.
# Keep the folder structure (so the compose bind mount has a source on a fresh
# clone) but ignore every real credential file inside it.
/secrets/*
!/secrets/.gitkeep
!/secrets/README.md
!/secrets/google/
/secrets/google/*
!/secrets/google/.gitkeep

# Laravel storage & cache
/backend/storage/*.key
/backend/bootstrap/cache/*.php

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.fleet/

# Scratch / debug scripts
/backend/_check.php
/backend/_count_import.php
/backend/_nullcheck.php
/backend/_serialcheck.php
/shot_bootstrap.php

# Database / filestore backups (never commit — large binaries, exceed host limits)
/filestore_backup.tar.gz
/odoo_backup.dump
*.dump
*.tar.gz
