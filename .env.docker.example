# =============================================================================
# FleetView — Docker Compose infrastructure config.
# Copy to `.env` (repo root, gitignored) and fill in. Compose reads THIS file
# for variable interpolation in docker-compose.yml.
#
# This file holds ONLY infrastructure values. The Laravel application config
# (APP_KEY, OFFICEMANAGER_*, GOOGLE_*, MAIL_*, ...) lives in backend/.env
# (copied from backend/.env.example). NEVER put real secrets in *.example.
# =============================================================================

# --- MySQL service ----------------------------------------------------------
# The `db` container creates this database + user on first boot. Compose feeds
# these SAME values to the backend as DB_DATABASE / DB_USERNAME / DB_PASSWORD
# (they OVERRIDE backend/.env), so the app + DB can never drift — you only set
# them here.
MYSQL_DATABASE=laravel
MYSQL_USER=fleet
MYSQL_PASSWORD=change_me_strong_password        # (SECRET) app DB user password
MYSQL_ROOT_PASSWORD=change_me_root_password      # (SECRET) MySQL root password

# --- Web tier ---------------------------------------------------------------
# Host port that publishes the app (nginx :80). Put a TLS-terminating reverse
# proxy (Caddy / Traefik / cloud LB) in front for HTTPS, or map 443 there.
APP_PORT=80

# API base URL baked into the React build. Same-origin default (nginx proxies
# /api to the backend). Only change if the SPA and API are on different hosts.
REACT_APP_API_URL=/api
