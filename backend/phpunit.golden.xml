<?xml version="1.0" encoding="UTF-8"?>
<!--
  The GOLDEN NUMBER suite (tests/Golden) — the regression net for Fleet Intelligence.

  WHY A THIRD CONFIG. The other two suites cannot host these tests:
    * phpunit.xml       runs on sqlite :memory: — no data at all.
    * phpunit.crud.xml  runs on `laravel_test` with RefreshDatabase, which migrate:fresh-es the
                        schema. These tests must read the REAL corpus (26,942 tickets, 49,487 fault
                        labels); a suite that wipes the database before every test can never assert
                        anything about it.

  So this config points at `laravel_golden` — a CLONE of the live `laravel` schema, created by
  run-golden-tests.cmd. The suite never touches live data, and every test here is read-only apart
  from the two rebuild commands, which only rewrite their own derived tables.

  Run it with:  run-golden-tests.cmd
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Golden">
            <directory>tests/Golden</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="laravel_golden"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="ASSET_LAYER_MODE" value="off"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
