{
  "info": {
    "name": "Dashboard & Intelligence",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ] },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Dashboard KPIs",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": {
          "raw": "{{base_url}}/Dashboard?expiring_days=7",
          "host": ["{{base_url}}"],
          "path": ["Dashboard"],
          "query": [ { "key": "expiring_days", "value": "7" } ]
        },
        "description": "Returns: total_outstanding_balance, active_contracts, expiring_registrations, vehicles_for_sale"
      }
    },
    {
      "name": "Customer balance (financial summary)",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{base_url}}/Customer/1/balance", "host": ["{{base_url}}"], "path": ["Customer", "1", "balance"] },
        "description": "Total debit/credit + outstanding balance across all of a customer's contracts"
      }
    }
  ]
}
