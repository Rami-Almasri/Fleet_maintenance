# =============================================================================
# FleetView — environment template
# Copy to .env and fill in. Values marked (SECRET) must never be committed.
# For PRODUCTION, set the values noted in the "prod:" hints below.
# =============================================================================

# --- App / core -------------------------------------------------------------
APP_NAME=FleetView
APP_ENV=local                       # prod: production
APP_KEY=                            # run: php artisan key:generate
APP_DEBUG=true                      # prod: false  (stops stack-trace leaks)
APP_URL=http://localhost            # prod: https://your-api-host

# SPA origin — used for notification deep-links AND CORS allow-list (see below).
APP_FRONTEND_URL=http://localhost:3000   # prod: https://your-app-host

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single                    # prod: daily (rotates)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                     # prod: warning (or error)
# Optional ops alerting — set to fan errors out to Slack:
# LOG_SLACK_WEBHOOK_URL=

# --- Database ---------------------------------------------------------------
# Live app runs on MySQL (XAMPP 'laravel'). SQLite is stale/dev-only.
# DOCKER: set DB_HOST=db (the compose service name), and DB_DATABASE / DB_USERNAME /
# DB_PASSWORD must MATCH MYSQL_DATABASE / MYSQL_USER / MYSQL_PASSWORD in the root .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                    # docker: db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root                     # docker: use the non-root app user (e.g. fleet)
DB_PASSWORD=                        # prod: set a real, non-empty password (SECRET)

# --- Session / cache / queue ------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log            # no broadcaster wired; log is fine
FILESYSTEM_DISK=local               # local storage (Spatie Media Library uses the 'media' disk)
QUEUE_CONNECTION=database           # no queued jobs exist; database/sync both fine
CACHE_STORE=database                # consider redis under load
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1                 # docker (only if using the redis profile): redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (only needed if NOTIFY_MAIL_ENABLED=true) -------------------------
MAIL_MAILER=log                     # prod: smtp (+ host/credentials below)
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null                  # (SECRET)
MAIL_PASSWORD=null                  # (SECRET)
MAIL_FROM_ADDRESS="fleet@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS / S3 media (OPTIONAL) ----------------------------------------------
# Storage defaults to LOCAL (FILESYSTEM_DISK=local). These are only needed if
# you opt back into S3 for the presigned direct-upload flow (inspection photos /
# repair videos). Leave AWS_BUCKET blank to keep everything on the local disk —
# the upload paths fall back to the local 'public' disk when no bucket is set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ffmpeg/ffprobe for video processing. NOT bundled in the Docker image (no
# server-side video transcoding is used). Only set these if you install ffmpeg
# yourself and enable Spatie video-thumbnail conversions:
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# --- OfficeManager (OM) API (SECRET) ---------------------------------------
# READ-ONLY replica; the app never pushes to it.
OFFICEMANAGER_API_KEY=
OFFICEMANAGER_BASE_URL=http://81.85.92.150:8080
# Keep false — the browser must never be able to trigger a sync/wipe.
OFFICEMANAGER_WEB_SYNC_ENABLED=false

# --- Google Sheets ----------------------------------------------------------
# Service-account JSON goes at storage/app/google/credentials.json (gitignored).
# Sync fully breaks without it. Grant the service account read on every sheet.
# DOCKER: put the file at ./secrets/google/credentials.json on the host — compose
# mounts it read-only at the default path below (no change needed here).
# GOOGLE_SHEETS_CREDENTIALS=storage/app/google/credentials.json
# Carry over all spreadsheet IDs/GIDs the deployment uses, e.g.:
# GOOGLE_SHEETS_FLEET_ID=
# GOOGLE_SHEETS_MAINTENANCE_GID=

# --- Notifications ----------------------------------------------------------
NOTIFY_MAIL_ENABLED=false           # parked; flip on only with real MAIL_* set

# --- AI Keyword Intelligence ------------------------------------------------
# Powers the automotive ontology behind the findings keyword library: synonyms,
# workshop wording, abbreviations, spelling variants, misspellings, Arabic terms
# and the engineering profile per fault. Used ONLY by `php artisan keywords:enrich`
# and the per-keyword "Build knowledge" button — free-text matching works without it.
ANTHROPIC_API_KEY=
KEYWORD_AI_MODEL=claude-opus-5
KEYWORD_AI_EFFORT=medium
