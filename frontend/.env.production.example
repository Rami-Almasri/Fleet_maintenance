# FleetView SPA — PRODUCTION build config.
#
# Copy this to `.env.production` on the build host BEFORE running the prod build
# (`npm run build`). Create React App bakes this in at build time — it is NOT a
# runtime value, so changing it later requires a rebuild.
#
# Set the base URL the browser uses to reach the Laravel API. Two common setups:
#
#   1) SPA and API on the SAME origin (Laravel serves the build, or a reverse
#      proxy fronts both). Use a relative path — no hostname to hardcode:
#         REACT_APP_API_URL=/api
#
#   2) SPA and API on DIFFERENT hosts. Use the full API URL:
#         REACT_APP_API_URL=https://api.your-domain.com/api
#
# Pick ONE and uncomment it below. Leaving this unset makes the build fall back
# to the dev default (http://127.0.0.1:8000/api) → a blank app in production.

REACT_APP_API_URL=/api
