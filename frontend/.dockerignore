# Keep the build context small and free of local artifacts/secrets.
node_modules/
build/
coverage/

# Local env — production build config is passed via --build-arg, never a file.
.env
.env.*
!.env.production.example

.git/
.gitignore
.vscode/
.idea/
Dockerfile
.dockerignore
npm-debug.log*
yarn-debug.log*
yarn-error.log*
